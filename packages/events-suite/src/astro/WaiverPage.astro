---
// Injected at `/_events/waiver` by the suite (SX-FR-02, SX-FR-03): the booking post of
// <BookingWithWaiver> and the inline waiver ceremony, one signer after another, on one page.
// Signing tokens live only in an HttpOnly cookie scoped to this path and in POST bodies to E-sign;
// receipts are forwarded to Events in-process. The page renders E-sign's <SigningCeremony> and, inline,
// only Events' page stylesheet, so it sends E-sign's `ceremonyCsp()` (hashes of the ceremony's own script,
// pad and stylesheet, and of the page's), `Referrer-Policy: no-referrer` and `no-store`.
import * as config from "virtual:semics-events-suite/config";
import SigningCeremony from "@semics-tech/emdash-esign/astro/SigningCeremony.astro";
import { ceremonyCsp } from "@semics-tech/emdash-esign/astro/lib/csp";
// T169: the document starts with a comment, so EmDash's editor toolbar stays off this signing page.
import { DOCUMENT_START } from "@semics-tech/emdash-esign/astro/lib/page";
import PageBrand from "@semics-tech/emdash-events/astro/PageBrand.astro";
import PageOrganiser from "@semics-tech/emdash-events/astro/PageOrganiser.astro";
import { crossSiteResponse } from "@semics-tech/emdash-events/astro/lib/checkout-form";
import { pageCss } from "@semics-tech/emdash-events/astro/lib/page";

import { handleWaiverRequest, leavesSite, payHandOff } from "./lib/flow";
import { WAIVER_MESSAGES, WAIVER_PATH } from "./lib/form";
import { waiverSlot } from "./lib/slot";

export const prerender = false;

const { esignPluginId, eventsPluginId, page } = config;
// Gift vouchers (T166): exported only when the site wires Vouchers, so read through the namespace.
const vouchersPluginId = (config as Partial<typeof config>).vouchersPluginId;

const outcome = await handleWaiverRequest(
	{ locals: Astro.locals, url: Astro.url, request: Astro.request, cookie: (name) => Astro.cookies.get(name)?.value },
	{
		eventsPluginId,
		esignPluginId,
		...(page.eventPath ? { eventPath: page.eventPath } : {}),
		...(vouchersPluginId ? { vouchersPluginId } : {}),
	},
);
if (outcome.type === "forbidden") return crossSiteResponse();
const cookies = outcome.type === "redirect" || outcome.type === "render" ? outcome.cookies : [];
for (const cookie of cookies) Astro.cookies.set(cookie.name, cookie.value, cookie.options);
if (outcome.type === "redirect" && !leavesSite(outcome.location, Astro.url)) return Astro.redirect(outcome.location, 303);
// The payment page is another site, which the CSP below stops a post from this page redirecting to (T155): a themed
// hand-off goes there instead. The booking form's own post is not under that CSP: it goes straight there (T169).
const payment = payHandOff(outcome, Astro.url);
if (outcome.type === "redirect" && !payment) return Astro.redirect(outcome.location, 303);

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");
const css = pageCss(page);
const stylesheet = page.stylesheet ? new URL(page.stylesheet, Astro.url).href : undefined;
Astro.response.headers.set("Content-Security-Policy", await ceremonyCsp({ styles: [css], stylesheet }));

const render = outcome.type === "render" ? outcome : undefined;
const ref = outcome.type === "render" || outcome.type === "error" ? (outcome.ref ?? "") : "";
const error = outcome.type === "error" ? (WAIVER_MESSAGES[outcome.code] ?? WAIVER_MESSAGES.INTERNAL) : "";
// The event and the booked date and time, so the signer can confirm what they sign for (T148).
const slot = render
	? await waiverSlot(
			{ locals: Astro.locals, url: Astro.url, request: Astro.request, cookie: (name) => Astro.cookies.get(name)?.value },
			{ eventsPluginId, esignPluginId },
			ref,
			undefined,
			render.booking,
		)
	: undefined;
// An expired or cancelled booking (T151): the message, a link back to the event, and no form.
const expired = outcome.type === "error" && outcome.code === "BOOKING_EXPIRED";
const eventLink = outcome.type === "error" ? outcome.href : undefined;
const signer = render?.view.kind === "ready" ? render.view.session.signer : undefined;
---
<Fragment set:html={DOCUMENT_START} />
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="referrer" content="no-referrer" />
		<title>{payment ? "Continue to payment" : "Sign the waiver"}</title>
		{payment && <meta http-equiv="refresh" content={`0;url=${payment}`} data-testid="waiver-pay-refresh" />}
		<style is:inline set:html={css}></style>
		{page.stylesheet && <link rel="stylesheet" href={page.stylesheet} />}
	</head>
	<body class="semics-page">
		<PageBrand brand={page.brand} />
		{payment ? (
			<main class="semics-esign semics-sign semics-page-main" data-testid="waiver-page" data-step="pay">
				<h1>Taking you to secure payment…</h1>
				<section class="semics-pay-handoff" aria-live="polite">
					<p>If the payment page does not open by itself, use the button below.</p>
					<p><a class="semics-page-button" href={payment} data-testid="waiver-pay-link">Continue to payment</a></p>
				</section>
			</main>
		) : (
		<main class="semics-esign semics-sign semics-page-main" data-testid="waiver-page" data-step={render ? "sign" : "error"}>
			<h1>Sign the waiver</h1>
			{error && <p role="alert" data-testid="waiver-error">{error}</p>}
			{expired && eventLink && <p><a href={eventLink} data-testid="waiver-book-again">Book again</a></p>}
			{
				outcome.type === "error" && outcome.code === "SIGNING_UNAVAILABLE" && ref && (
					<form method="post" action={`${WAIVER_PATH}?ref=${ref}`} data-testid="waiver-retry">
						<input type="hidden" name="intent" value="retry" />
						<button type="submit">Try again</button>
					</form>
				)
			}
			{render && (
				<>
					{(slot || signer?.participant || render.remaining > 0) && (
						<section class="semics-waiver-summary" aria-label="Your booking" data-testid="waiver-summary">
							{slot && (
								<p data-testid="waiver-slot">
									{slot.title && <strong data-testid="waiver-event">{slot.title}</strong>}
									{slot.title && slot.when && <br />}
									{slot.when && <time datetime={slot.startsAt} data-testid="waiver-when">{slot.when}</time>}
								</p>
							)}
							{signer?.participant && <p data-testid="waiver-for">Signing as guardian for <strong>{signer.participant}</strong>.</p>}
							{render.remaining > 0 && (
								<p data-testid="waiver-remaining">
									{render.remaining === 1 ? "One more waiver follows this one." : `${render.remaining} more waivers follow this one.`}
								</p>
							)}
						</section>
					)}
					<SigningCeremony view={render.view} action={`${WAIVER_PATH}?ref=${ref}`} token={render.token} pluginId={esignPluginId} />
				</>
			)}
			{ref && <p><a href={`/booking?ref=${ref}`}>Back to your booking</a></p>}
		</main>
		)}
		<PageOrganiser brand={page.brand} locale="en-GB" />
	</body>
</html>
