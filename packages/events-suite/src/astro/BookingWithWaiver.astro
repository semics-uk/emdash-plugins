---
// <BookingWithWaiver event={entryId} /> (SX-FR-02): books an event whose tickets need a signed waiver,
// in one flow: this form → `/_events/waiver` (reserve, attendees, signing intents) → the waiver
// signed inline on that page → back to the booking page, confirmed. A plain form post: no JavaScript.
//
// One row per attendee, each with an "under 18" control: the buyer signs for themselves and, as
// guardian, for every attendee under 18; other adults sign their own waiver from an email. Without
// Events Pro (waivers are Pro) the same form makes a plain booking. All text is rendered as text.
import { eventsPluginId } from "virtual:semics-events-suite/config";
import { callPublicRoute } from "@semics-tech/emdash-events/astro/lib/call";
import {
	pickerFetchFrom,
	pickerHref,
	pickerParam,
	pickerView,
	usesPicker,
} from "@semics-tech/emdash-events/astro/lib/picker";
import { fieldMessage, formatMoney, newIdempotencyKey, type PublicEvent } from "@semics-tech/emdash-events/astro/lib/widget";
import { translator } from "@semics-tech/emdash-events/i18n";

import {
	DEFAULT_SEATS,
	MAX_SEATS,
	readWaiverState,
	safeReturnPath,
	seatField,
	WAIVER_MESSAGES,
	WAIVER_PATH,
	waiverAnchor,
} from "./lib/form";

interface Props {
	/** The event's content entry id. */
	event: string;
	/** The `public/event` answer, when the page already has it. */
	data?: PublicEvent;
	heading?: string;
	/** Attendee rows to offer (1-10, default 4). */
	seats?: number;
	locale?: string;
}

const { event: eventId, heading = "Book with waiver", locale = "en-GB" } = Astro.props;
const seats = Math.min(MAX_SEATS, Math.max(1, Math.trunc(Astro.props.seats ?? DEFAULT_SEATS)));
let data = Astro.props.data;
// The day-then-time picker's page (T130, T134): this widget's own `booking_from.<eventId>`, as Events' widget reads it.
const pickerStart = Astro.url.searchParams.get(pickerParam(eventId));
if (!data) {
	const from = pickerFetchFrom(pickerStart);
	const result = await callPublicRoute<PublicEvent>(Astro, {
		path: "public/event",
		pluginId: eventsPluginId,
		body: { eventId, ...(from ? { from } : {}) },
	});
	if (result.ok) data = result.data;
}
const { t } = translator(locale);

const id = waiverAnchor(eventId);
const state = readWaiverState(Astro.url, eventId);
const alert = state.code ? (WAIVER_MESSAGES[state.code] ?? WAIVER_MESSAGES.INTERNAL) : "";
const bad = (field: string) => (state.fields.includes(field) ? "true" : undefined);
const returnTo = safeReturnPath(`${Astro.url.pathname}${Astro.url.search}`, Astro.url.origin) ?? "";
const ticketTypes = (data?.ticketTypes ?? []).filter((t) => t.available !== 0);
const occurrences = data?.occurrences ?? [];
const onSale = data?.status === "on_sale" && ticketTypes.length > 0;
const siteKey = data?.turnstileSiteKey ?? "";
const price = (minor: number) => formatMoney(minor, data?.currency ?? "GBP", locale);
// A slot schedule (or two starts a day): a month calendar of days, then the day's times. Without
// JavaScript the same month's dates show as a select grouped by day. Dated events keep the plain select.
const zone = data?.timezone ?? "UTC";
const picker = usesPicker(data, zone)
	? pickerView(occurrences, { zone, locale, start: pickerStart, now: Date.now(), more: data?.more === true })
	: null;
const monthId = `${id}-month`;
const errId = `${id}-occurrence-error`;
const when = (iso: string) => {
	const options = { dateStyle: "full", timeStyle: "short" } as const;
	try {
		return new Intl.DateTimeFormat(locale, { ...options, timeZone: data?.timezone ?? "UTC" }).format(new Date(iso));
	} catch {
		return new Intl.DateTimeFormat(locale, { ...options, timeZone: "UTC" }).format(new Date(iso));
	}
};
// Attendee rows are only for an event whose waiver is required (`public/event` says so, T066); any other
// event is booked by ticket type and quantity, as a plain booking.
const needsWaiver = data?.waiver === true;
const rows = needsWaiver ? Array.from({ length: seats }, (_, i) => i + 1) : [];
const single = ticketTypes.length === 1 ? ticketTypes[0] : undefined;
---
<section id={id} class="semics-events semics-waiver-widget" aria-labelledby={`${id}-title`} data-testid="booking-with-waiver">
	<h2 id={`${id}-title`}>{heading}</h2>
	{
		!onSale ? (
			<p data-testid="booking-unavailable">Booking is not available for this event right now.</p>
		) : (
			<form method="post" action={WAIVER_PATH} data-keep-values>
				<p class="semics-form-alert" role="alert" data-testid="waiver-alert" hidden={!alert}>{alert}</p>
				<input type="hidden" name="intent" value="book" />
				<input type="hidden" name="eventId" value={eventId} />
				<input type="hidden" name="returnTo" value={returnTo} />
				<input type="hidden" name="idempotencyKey" value={newIdempotencyKey()} />
				{data?.waiverEach && <input type="hidden" name="waiverEach" value="1" />}

				{picker && (
					<div class="semics-field semics-picker-field">
						<input type="hidden" name="needsOccurrence" value="1" />
						<div class="semics-field" data-picker-fallback>
							<label for={`${id}-occurrence`}>{t("widget.date")}</label>
							<select
								id={`${id}-occurrence`}
								name="occurrenceId"
								required
								aria-invalid={bad("occurrence")}
								aria-describedby={[monthId, errId].join(" ")}
							>
								<option value="">{t("widget.chooseDate")}</option>
								{picker.days.map((day) => (
									<optgroup label={day.label}>
										{day.slots.map((s) => (
											<option value={s.id} disabled={s.full}>{s.label}</option>
										))}
									</optgroup>
								))}
							</select>
						</div>
						<nav class="semics-picker-nav" aria-labelledby={monthId}>
							<p id={monthId} class="semics-picker-month">{picker.month.label}</p>
							{picker.prev && <a href={pickerHref(Astro.url, picker.prev, eventId)} rel="nofollow">{t("widget.picker.earlier")}</a>}
							{picker.next && <a href={pickerHref(Astro.url, picker.next, eventId)} rel="nofollow">{t("widget.picker.later")}</a>}
						</nav>
						{picker.days.length === 0 && <p data-testid="picker-none">{t("widget.picker.none")}</p>}
						<fieldset
							class="semics-picker"
							data-picker
							data-field="occurrence"
							data-testid="booking-picker"
							hidden
							aria-invalid={bad("occurrence")}
							aria-describedby={errId}
						>
							<legend>{t("widget.date")}</legend>
							<table role="grid" class="semics-calendar" aria-labelledby={monthId}>
								<thead>
									<tr>
										{picker.weekdays.map((w) => (
											<th scope="col" abbr={w.long}>{w.short}</th>
										))}
									</tr>
								</thead>
								<tbody>
									{picker.weeks.map((week) => (
										<tr>
											{week.map((cell) => (
												<td>
													{cell && cell.slots.length > 0 ? (
														<button
															type="button"
															class={cell.open ? undefined : "semics-day-full"}
															data-day={cell.key}
															data-n={String(cell.day)}
															aria-label={cell.buttonLabel}
															aria-pressed="false"
															tabindex={cell.key === picker.focusDay ? "0" : "-1"}
														>
															{cell.day}
														</button>
													) : cell ? (
														<span class="semics-day-none">{cell.day}</span>
													) : null}
												</td>
											))}
										</tr>
									))}
								</tbody>
							</table>
							<p class="semics-hint" data-picker-hint>{t("widget.picker.hint")}</p>
							{picker.days.map((day) => (
								<div class="semics-times" role="radiogroup" data-times={day.key} aria-label={t("widget.picker.times", { date: day.label })} hidden>
									{day.slots.map((s, i) => (
										<button
											type="button"
											role="radio"
											aria-checked="false"
											aria-disabled={s.full ? "true" : undefined}
											aria-label={s.label}
											data-occurrence={s.id}
											tabindex={i === day.slots.findIndex((x) => !x.full) ? "0" : "-1"}
										>
											<span>{s.time}</span>
											{s.places && <span class="semics-places">{s.places}</span>}
										</button>
									))}
								</div>
							))}
						</fieldset>
						{bad("occurrence") && <p class="semics-field-error" id={errId}>{fieldMessage("occurrence", locale)}</p>}
					</div>
				)}

				{!picker && occurrences.length > 0 && (
					<div class="semics-field">
						<input type="hidden" name="needsOccurrence" value="1" />
						<label for={`${id}-occurrence`}>Date</label>
						<select id={`${id}-occurrence`} name="occurrenceId" required aria-invalid={bad("occurrence")}>
							<option value="">Choose a date</option>
							{occurrences.map((o) => (
								<option value={o.id} disabled={o.available === 0}>
									{when(o.startsAt)}
									{o.available === 0 ? " (sold out)" : ""}
								</option>
							))}
						</select>
					</div>
				)}

				<fieldset>
					<legend>You</legend>
					<div class="semics-field">
						<label for={`${id}-name`}>Your name</label>
						<input id={`${id}-name`} name="name" type="text" autocomplete="name" required maxlength="200" aria-invalid={bad("name")} />
					</div>
					<div class="semics-field">
						<label for={`${id}-email`}>Your email</label>
						<input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="254" aria-invalid={bad("email")} />
					</div>
				</fieldset>

				{!needsWaiver && (
					<fieldset data-testid="waiver-plain">
						<legend>Tickets</legend>
						<input type="hidden" name="plain" value="1" />
						<div class="semics-field">
							<label for={`${id}-plain-type`}>Ticket</label>
							<select id={`${id}-plain-type`} name="ticketTypeId" aria-invalid={bad("tickets")}>
								{ticketTypes.map((t) => (
									<option value={t.id}>{t.name} ({price(t.priceMinor)})</option>
								))}
							</select>
						</div>
						<div class="semics-field">
							<label for={`${id}-plain-qty`}>How many</label>
							<input id={`${id}-plain-qty`} name="qty" type="number" min="1" max={MAX_SEATS} value="1" required aria-invalid={bad("tickets")} />
						</div>
					</fieldset>
				)}

				{needsWaiver && (
					<p class="semics-note" id={`${id}-who`}>
						List everyone attending, including you if you are going. You sign the waiver now, for yourself and
						for anyone under 18. Other adults need their own email address: they are sent their waiver to sign.
					</p>
				)}
				{bad("attendees") && <p class="semics-field-error" data-testid="waiver-attendees-error">Add at least one attendee, and an email for each other adult.</p>}

				{rows.map((n) => (
					<fieldset class="semics-attendee" data-testid="waiver-attendee" aria-describedby={`${id}-who`}>
						<legend>Attendee {n}</legend>
						{single ? (
							<input type="hidden" name={seatField(n, "ticketTypeId")} value={single.id} />
						) : (
							<div class="semics-field">
								<label for={`${id}-${n}-type`}><span class="semics-sr">Attendee {n} </span>Ticket</label>
								<select id={`${id}-${n}-type`} name={seatField(n, "ticketTypeId")} aria-invalid={bad(seatField(n, "ticketTypeId"))}>
									{ticketTypes.map((t) => (
										<option value={t.id}>{t.name} ({price(t.priceMinor)})</option>
									))}
								</select>
							</div>
						)}
						<div class="semics-field">
							<label for={`${id}-${n}-name`}><span class="semics-sr">Attendee {n} </span>Name</label>
							<input id={`${id}-${n}-name`} name={seatField(n, "name")} type="text" maxlength="200" required={n === 1 || undefined} aria-invalid={bad(seatField(n, "name"))} />
						</div>
						<div class="semics-field">
							<label for={`${id}-${n}-email`}><span class="semics-sr">Attendee {n} </span>Email (optional)</label>
							<input id={`${id}-${n}-email`} name={seatField(n, "email")} type="email" maxlength="254" aria-invalid={bad(seatField(n, "email"))} />
						</div>
						<div class="semics-check">
							<input id={`${id}-${n}-minor`} name={seatField(n, "minor")} type="checkbox" />
							<label for={`${id}-${n}-minor`}><span class="semics-sr">Attendee {n} is </span>Under 18</label>
						</div>
					</fieldset>
				))}

				{needsWaiver && single && <p class="semics-note">{single.name}: {price(single.priceMinor)} per attendee.</p>}

				{siteKey && (
					<>
						<div class="cf-turnstile" data-sitekey={siteKey}></div>
						{/* Compact below 300 px so a 320 px screen never scrolls sideways (WCAG 1.4.10). */}
						<script is:inline>(function (s) { var t = s && s.previousElementSibling; if (t && t.clientWidth < 300) t.setAttribute("data-size", "compact"); })(document.currentScript);</script>
						<noscript><p class="semics-note">This form uses a security check that needs JavaScript.</p></noscript>
						<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
					</>
				)}

				<button type="submit">Book</button>
			</form>
		)
	}
</section>

<script>
	// In this order: the kept values go back first, then the picker shows the date the select holds.
	import "./lib/keep-form";
	import "@semics-tech/emdash-events/client/picker";
</script>

<style>
	.semics-waiver-widget {
		--_fg: var(--events-fg, #1a1a1a);
		--_muted: var(--events-muted, #4a4a4a);
		--_bg: var(--events-bg, #ffffff);
		--_border: var(--events-border, #6b6b6b);
		--_accent: var(--events-accent, #0b57d0);
		--_accent-fg: var(--events-accent-fg, #ffffff);
		--_error: var(--events-error, #b3261e);
		--_radius: var(--events-radius, 6px);
		box-sizing: border-box;
		max-inline-size: 36rem;
		padding: 1rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		background: var(--_bg);
		color: var(--_fg);
		overflow-wrap: anywhere;
	}
	.semics-waiver-widget *,
	.semics-waiver-widget *::before,
	.semics-waiver-widget *::after {
		box-sizing: border-box;
	}
	.semics-waiver-widget h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}
	.semics-waiver-widget form {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
	}
	.semics-waiver-widget fieldset {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		min-inline-size: 0;
	}
	.semics-field {
		display: grid;
		gap: 0.25rem;
	}
	.semics-check {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.semics-waiver-widget input:not([type="checkbox"]),
	.semics-waiver-widget select,
	.semics-waiver-widget button {
		font: inherit;
		min-block-size: 2.75rem;
		max-inline-size: 100%;
	}
	.semics-waiver-widget input:not([type="checkbox"]),
	.semics-waiver-widget select {
		inline-size: 100%;
		padding: 0.375rem 0.5rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		background: var(--_bg);
		color: var(--_fg);
	}
	.semics-waiver-widget input[type="checkbox"] {
		inline-size: 1.25rem;
		block-size: 1.25rem;
	}
	.semics-waiver-widget [aria-invalid="true"] {
		border-color: var(--_error);
		outline: 1px solid var(--_error);
	}
	.semics-hint {
		color: var(--_muted);
	}
	.semics-picker-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1rem;
	}
	.semics-picker-month {
		margin: 0;
		margin-inline-end: auto;
		font-weight: 600;
	}
	.semics-picker-nav a {
		color: var(--_accent);
		min-block-size: 1.5rem;
	}
	.semics-picker {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0.5rem 0.75rem 0.75rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		min-inline-size: 0;
	}
	.semics-picker p {
		margin: 0;
	}
	.semics-calendar {
		inline-size: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		text-align: center;
	}
	.semics-calendar th {
		padding-block: 0.25rem;
		font-weight: 400;
		font-size: 0.875rem;
		color: var(--_muted);
	}
	.semics-calendar td {
		padding: 1px;
	}
	.semics-waiver-widget .semics-calendar button,
	.semics-waiver-widget .semics-times button {
		inline-size: 100%;
		padding: 0.25rem;
		border: 1px solid var(--_accent);
		background: var(--_bg);
		color: var(--_accent);
	}
	.semics-waiver-widget .semics-calendar button.semics-day-full,
	.semics-waiver-widget .semics-times button[aria-disabled="true"] {
		border-color: var(--_border);
		color: var(--_muted);
		text-decoration: line-through;
	}
	.semics-waiver-widget .semics-times button[aria-disabled="true"] {
		cursor: not-allowed;
	}
	.semics-waiver-widget .semics-calendar button[aria-pressed="true"],
	.semics-waiver-widget .semics-times button[aria-checked="true"] {
		background: var(--_accent);
		color: var(--_accent-fg);
	}
	.semics-day-none {
		display: block;
		padding-block: 0.75rem;
		color: var(--_muted);
	}
	.semics-times {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
		gap: 0.5rem;
	}
	.semics-waiver-widget .semics-times button {
		display: grid;
		justify-items: center;
	}
	.semics-places {
		font-size: 0.875rem;
	}
	.semics-note {
		margin: 0;
		color: var(--_muted);
	}
	.semics-field-error,
	.semics-form-alert {
		margin: 0;
		color: var(--_error);
	}
	.semics-form-alert {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--_error);
		border-radius: var(--_radius);
	}
	.semics-sr {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.semics-waiver-widget button {
		justify-self: start;
		padding: 0.5rem 1.5rem;
		border: 0;
		border-radius: var(--_radius);
		background: var(--_accent);
		color: var(--_accent-fg);
		cursor: pointer;
	}
	.semics-waiver-widget :focus-visible {
		outline: 3px solid var(--_accent);
		outline-offset: 2px;
	}
	.semics-waiver-widget [hidden] {
		display: none !important;
	}
</style>
