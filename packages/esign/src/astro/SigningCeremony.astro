---
// <SigningCeremony> (SU-FR-03..08, SU-NFR-01..03): the document, the signer's fields, the typed
// signature (and the optional drawn signature pad, T031), the consent and intent boxes, decline, and
// the completion screen. Give it the view from `handleSign` (lib/sign.ts).
//
// Works without JavaScript: both forms post to `action`. The inlined client script (allowed by
// hash, see lib/csp.ts: a page rendering this must send `ceremonyCsp()`) keeps Sign disabled
// until the form is complete and, after signing, polls `public/session` for the signed PDF.
//
// The snapshot is rendered only through the parsed tree (lib/markdown.ts) and `{…}` text, never
// as HTML. Its exact hashed text is offered verbatim beside its SHA-256.
//
// An uploaded PDF (E-sign Pro, T094) is offered as links to open or download it, beside the SHA-256 of the
// file, and never embedded: the core serves it with `Content-Security-Policy: sandbox`, under which browsers'
// built-in PDF viewers do not run in a frame, and this page's CSP allows no frames. Without a link (a core that
// cannot serve the PDF) the page says so and offers no signing form.
import { clientMessages, pickLocale, segments, translator } from "../i18n/index.ts";
import { CEREMONY_CSS, CEREMONY_SCRIPT, PAD_SCRIPT } from "./lib/assets";
import { ESIGN_PLUGIN_ID } from "./lib/call";
import { parseSnapshot } from "./lib/markdown";
import { fieldName, pdfDocumentView, type SignView, sessionFields, signMessage } from "./lib/sign";
import SnapshotBlocks from "./SnapshotBlocks.astro";

interface Props {
	view: SignView;
	/** Where both forms post: the page that calls `handleSign`. */
	action: string;
	/** The signing token, for the signed-PDF poll (sent in a POST body only). */
	token: string;
	/** The core's plugin id, when it is not the default slug. */
	pluginId?: string;
	/** The page's language (T102); else `Astro.currentLocale`, else British English. */
	locale?: string;
}

const { view, action, token, pluginId = ESIGN_PLUGIN_ID } = Astro.props;
const locale = pickLocale(Astro.props.locale, Astro.currentLocale);
const { t, lang, dir } = translator(locale);
// The client scripts' messages, in this language: they hold no text of their own.
const messages = JSON.stringify(clientMessages(locale, "ceremony."));
const padMessages = JSON.stringify(clientMessages(locale, "pad."));
// A refusal's message in the page's language, by its code (a view's own `message` is English).
const refusal = (code: string | undefined, fallback?: string) => (code ? signMessage(code, locale) : (fallback ?? ""));
const ready = view.kind === "ready" ? view : undefined;
const session = ready?.session;
const blocks = session ? parseSnapshot(session.snapshot ?? "") : [];
const fields = session ? sessionFields(session) : [];
const pdfDoc = session ? pdfDocumentView(session, locale) : undefined;
const canSign = session?.otp !== "required" && (!pdfDoc || pdfDoc.url !== undefined);
const bad = (name: string) => (ready?.fields ?? []).includes(name) || undefined;
// A field to fix is described by the message that says why (WCAG 3.3.1).
const fix = (name: string) => (bad(name) && ready?.message ? { "aria-invalid": "true", "aria-describedby": "esign-error" } : {});
// The email-code step (T091) carries its own messages, beside the code box, and both of its forms come
// back to it (`#esign-otp`), so after a post the next Tab is in the step, not at the top of a long document.
const needsCode = session?.otp === "required";
const otpAction = `${action}#esign-otp`;
const badCode = ["OTP_INVALID", "OTP_EXPIRED", "OTP_LOCKED", "OTP_REQUIRED"].includes(ready?.errorCode ?? "") ? "true" : undefined;
const pdfPending =
	(view.kind === "signed" || (view.kind === "closed" && view.status === "completed")) &&
	!view.download &&
	view.pdf === "pending";
const doneLink = (view.kind === "signed" || view.kind === "closed") && view.download ? view.download : undefined;
---
<div class="semics-esign semics-ceremony" lang={lang} dir={dir} data-messages={messages} data-testid="signing-ceremony" data-state={view.kind}>
	{view.kind === "error" && <p role="alert" class="semics-error" data-testid="sign-error" data-code={view.code}>{refusal(view.code, view.message)}</p>}
	{
		view.kind === "closed" && (
			<section data-testid="sign-closed" data-status={view.status} {...(pdfPending ? { "data-esign-poll": "", "data-token": token, "data-plugin": pluginId } : {})}>
				<p>
					{view.status === "completed"
						? t("sign.closed.completed")
						: view.status === "declined"
							? t("sign.closed.declined")
							: t("sign.closed.other")}
				</p>
				{(doneLink || pdfPending) && (
					<p data-esign-pdf aria-live="polite">
						{doneLink ? <a href={doneLink}>{t("sign.download")}</a> : t("sign.preparingShort")}
					</p>
				)}
				{view.returnUrl && <p><a href={view.returnUrl} rel="noreferrer">{t("sign.return")}</a></p>}
			</section>
		)
	}
	{
		view.kind === "waiting" && (
			<section data-testid="sign-waiting">
				<p>{view.title ? t("sign.waiting.titled", { title: view.title }) : t("sign.waiting.untitled")}</p>
				<p>{t("sign.waiting.email")}</p>
			</section>
		)
	}
	{
		view.kind === "signed" && view.waiting && (
			<section data-testid="sign-done" data-waiting>
				<p>{t("sign.thanks")}</p>
				<p>{t("sign.othersToSign")}</p>
				{view.returnUrl && <p><a href={view.returnUrl} rel="noreferrer">{t("sign.return")}</a></p>}
			</section>
		)
	}
	{
		view.kind === "signed" && !view.waiting && (
			<section data-testid="sign-done" {...(pdfPending ? { "data-esign-poll": "", "data-token": token, "data-plugin": pluginId } : {})}>
				<p>{t("sign.thanks")}</p>
				<p data-esign-pdf aria-live="polite">
					{doneLink ? <a href={doneLink}>{t("sign.download")}</a> : t("sign.preparing")}
				</p>
				{view.returnUrl && <p><a href={view.returnUrl} rel="noreferrer">{t("sign.return")}</a></p>}
			</section>
		)
	}
	{
		view.kind === "declined" && (
			<section data-testid="sign-declined">
				<p>{t("sign.declined")}</p>
				{view.returnUrl && <p><a href={view.returnUrl} rel="noreferrer">{t("sign.return")}</a></p>}
			</section>
		)
	}
	{
		ready && session && (
			<>
				{ready.message && !needsCode && <p role="alert" id="esign-error" class="semics-error" data-testid="sign-error" data-code={ready.errorCode}>{refusal(ready.errorCode, ready.message)}</p>}
				<p>
					{segments(
						session.signer?.as
							? t("sign.signingAsRole", { role: session.signer.as })
							: t("sign.signingAs"),
					).map((s) => (s.slot === "name" ? <strong>{session.signer?.name}</strong> : s.text))}
				</p>
				{pdfDoc ? (
					<section aria-label={t("sign.document")} data-testid="sign-pdf">
						<p>
							{segments(t("sign.pdf.intro", { pages: pdfDoc.pagesLabel, size: pdfDoc.size })).map((s) =>
								s.slot === "name" ? <strong>{pdfDoc.name}</strong> : s.text,
							)}
						</p>
						{pdfDoc.url ? (
							<p>
								{segments(t("sign.pdf.links")).map((s) =>
									s.slot === "open" ? (
										<a href={pdfDoc.url} target="_blank" rel="noopener noreferrer" data-testid="sign-pdf-open">{t("sign.pdf.open")}</a>
									) : s.slot === "download" ? (
										<a href={pdfDoc.url} download={pdfDoc.name} data-testid="sign-pdf-download">{t("sign.pdf.download")}</a>
									) : (
										s.text
									),
								)}
							</p>
						) : (
							<p role="alert" class="semics-error" data-testid="sign-pdf-unavailable">{t("sign.pdf.unavailable")}</p>
						)}
						<p>
							{segments(t("sign.pdf.fingerprint")).map((s) =>
								s.slot === "hash" ? <span class="semics-hash">{session.envelope?.docSha256}</span> : s.text,
							)}
						</p>
					</section>
				) : (
					<section aria-label={t("sign.document")} data-testid="sign-document">
						<div class="semics-doc"><SnapshotBlocks blocks={blocks} /></div>
						<details data-testid="sign-exact">
							<summary>{t("sign.exact.summary")}</summary>
							<p>
								{segments(t("sign.exact.fingerprint")).map((s) =>
									s.slot === "hash" ? <span class="semics-hash">{session.envelope?.docSha256}</span> : s.text,
								)}
							</p>
							<pre>{session.snapshot}</pre>
						</details>
					</section>
				)}
				{
					session.otp === "required" && (
						<section id="esign-otp" data-testid="sign-otp" aria-label={t("sign.otp.label")}>
							<p>{t("sign.otp.intro")}</p>
							{ready.message && <p role="alert" id="esign-error" class="semics-error" data-testid="sign-error" data-code={ready.errorCode}>{refusal(ready.errorCode, ready.message)}</p>}
							{ready.otpSent && <p role="status" data-testid="sign-otp-sent">{t("sign.otp.sent")}</p>}
							<form method="post" action={otpAction}>
								<button type="submit" name="intent" value="otp-send">{t("sign.otp.send")}</button>
							</form>
							<form method="post" action={otpAction}>
								<div class="semics-field">
									<label for="esign-code">{t("sign.otp.code")}</label>
									<p id="esign-code-hint" class="semics-note">{t("sign.otp.hint")}</p>
									<input
										id="esign-code"
										name="code"
										type="text"
										inputmode="numeric"
										autocomplete="one-time-code"
										pattern="[0-9]{6}"
										maxlength="6"
										required
										aria-describedby={ready.message ? "esign-code-hint esign-error" : "esign-code-hint"}
										aria-invalid={badCode || undefined}
									/>
								</div>
								<button type="submit" name="intent" value="otp-verify">{t("sign.otp.verify")}</button>
							</form>
						</section>
					)
				}
				{canSign && <form method="post" action={action} data-esign-sign-form data-consent-version={session.consent?.version}>
					{
						fields.length > 0 && (
							<fieldset>
								<legend>{t("sign.details")}</legend>
								{fields.map((field) => (
									<div class="semics-field">
										<label for={`esign-field-${field.key}`}>{field.required ? t("sign.required", { label: field.label }) : field.label}</label>
										<input
											id={`esign-field-${field.key}`}
											name={fieldName(field.key)}
											type="text"
											maxlength="500"
											data-esign-field
											data-label={field.label}
											required={field.required || undefined}
											{...fix(fieldName(field.key))}
										/>
									</div>
								))}
							</fieldset>
						)
					}
					<fieldset>
						<legend>{t("sign.signature")}</legend>
						<div class="semics-field">
							<label for="esign-name">{t("sign.typedName")}</label>
							<input id="esign-name" name="typedName" type="text" autocomplete="name" required maxlength="200" {...fix("typedName")} />
						</div>
						<div data-esign-pad-slot data-messages={padMessages} data-testid="sign-pad-slot">
							<slot name="pad" />
							<input type="hidden" name="signatureStrokes" value="" />
							{bad("signature") && <p class="semics-error">{refusal(ready.errorCode, ready.message)}</p>}
						</div>
					</fieldset>
					<div class="semics-check">
						<input id="esign-consent" name="consent" type="checkbox" required {...fix("consent")} />
						<label for="esign-consent">{session.consent?.wording}</label>
					</div>
					<div class="semics-check">
						<input id="esign-agree" name="agree" type="checkbox" required {...fix("agree")} />
						<label for="esign-agree">{t("sign.agree")}</label>
					</div>
					<p id="esign-missing" class="semics-note" data-esign-missing data-testid="sign-missing" aria-live="polite" hidden></p>
					<button type="submit" name="intent" value="sign" data-esign-sign aria-describedby="esign-missing">{t("sign.submit")}</button>
				</form>}
				<form method="post" action={action} class="semics-decline">
					<div class="semics-field">
						<label for="esign-reason">{t("sign.decline.label")}</label>
						<input id="esign-reason" name="reason" type="text" maxlength="500" />
					</div>
					<button type="submit" name="intent" value="decline" data-esign-decline>{t("sign.decline.button")}</button>
				</form>
			</>
		)
	}
</div>
<style is:inline set:html={CEREMONY_CSS}></style>
<script is:inline type="module" set:html={CEREMONY_SCRIPT}></script>
<script is:inline type="module" set:html={PAD_SCRIPT}></script>
