---
// Injected at `/sign/[token]` by the integration (SU-FR-01). The one place a token may sit in a URL:
// this page's path. It sends `Referrer-Policy: no-referrer`, is never cached, and passes the token
// to the core only in POST bodies. A plain form post works without JavaScript. Its CSP allows only
// the ceremony's own hashed script and style (SU-NFR-02), and the site's page sheet (T169).
import { page, pluginId } from "virtual:semics-esign/config";
import { pickLocale, translator } from "../i18n/index.ts";
import EsignPage from "./EsignPage.astro";
import { ceremonyCsp } from "./lib/csp";
import { crossSiteResponse, isCrossSiteRequest } from "./lib/csrf";
import { pageView } from "./lib/page";
import { ceremonyRedirect, handleSign } from "./lib/sign";
import SigningCeremony from "./SigningCeremony.astro";

export const prerender = false;

// Sign and decline are form posts: refuse one another site made (CSRF, T034).
if (isCrossSiteRequest(Astro.request, Astro.url)) return crossSiteResponse();

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");
const look = pageView(page, Astro.url);
Astro.response.headers.set(
	"Content-Security-Policy",
	await ceremonyCsp({ styles: [look.css], stylesheet: look.stylesheet }),
);

const token = typeof Astro.params.token === "string" ? Astro.params.token : "";
const form = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => new FormData()) : null;
// The page's language is the site's (Astro i18n), else British English (T102).
const locale = pickLocale(Astro.currentLocale);
const { t, lang, dir } = translator(locale);
const view = await handleSign({ locals: Astro.locals, url: Astro.url, request: Astro.request, pluginId }, token, form);
// The ceremony ended for an integration's envelope: back to its site with the receipt in the URL
// fragment (protocol §8.2), never a query string. The redirect keeps no-referrer and no-store.
const back = form ? ceremonyRedirect(view) : undefined;
if (back) {
	return new Response(null, {
		status: 303,
		headers: { Location: back, "Referrer-Policy": "no-referrer", "Cache-Control": "private, no-store" },
	});
}
---
<EsignPage title={t("sign.title")} lang={lang} dir={dir} css={look.css} stylesheet={look.stylesheet} brand={look.brand}>
	<meta name="referrer" content="no-referrer" slot="head" />
	<main class="semics-esign semics-sign semics-page-main" data-testid="sign-page" data-state={view.kind}>
		<h1>{view.kind === "ready" ? view.session.envelope?.title ?? t("sign.title") : t("sign.title")}</h1>
		<SigningCeremony view={view} action={Astro.url.pathname} token={token} pluginId={pluginId} locale={locale} />
	</main>
</EsignPage>
