---
// Injected at `/sign/[token]` by the integration (SU-FR-01). The one place a token may sit in a URL:
// this page's path. It sends `Referrer-Policy: no-referrer`, is never cached, and passes the token
// to the core only in POST bodies. A plain form post works without JavaScript. Its CSP allows only
// the ceremony's own hashed script and style (SU-NFR-02).
import { pluginId } from "virtual:semics-esign/config";
import { ceremonyCsp } from "./lib/csp";
import { crossSiteResponse, isCrossSiteRequest } from "./lib/csrf";
import { handleSign } from "./lib/sign";
import SigningCeremony from "./SigningCeremony.astro";

export const prerender = false;

// Sign and decline are form posts: refuse one another site made (CSRF, T034).
if (isCrossSiteRequest(Astro.request, Astro.url)) return crossSiteResponse();

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Content-Security-Policy", await ceremonyCsp());

const token = typeof Astro.params.token === "string" ? Astro.params.token : "";
const form = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => new FormData()) : null;
const view = await handleSign({ locals: Astro.locals, url: Astro.url, request: Astro.request, pluginId }, token, form);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="referrer" content="no-referrer" />
		<title>Sign a document</title>
	</head>
	<body>
		<main class="semics-esign semics-sign" data-testid="sign-page" data-state={view.kind}>
			<h1>{view.kind === "ready" ? view.session.envelope?.title ?? "Sign a document" : "Sign a document"}</h1>
			<SigningCeremony view={view} action={Astro.url.pathname} token={token} pluginId={pluginId} />
		</main>
	</body>
</html>
