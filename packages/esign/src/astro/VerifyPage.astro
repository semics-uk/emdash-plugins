---
// Injected at `/verify` by the integration (SU-FR-02, ES-US-6). Works without JavaScript: the visitor
// pastes the signed PDF's SHA-256; with scripts, they choose or drop the PDF and it is fingerprinted
// in the browser (never uploaded). Its CSP allows only the page's own hashed script and style.
import { page, pluginId } from "virtual:semics-esign/config";
import { pickLocale, translator } from "../i18n/index.ts";
import EsignPage from "./EsignPage.astro";
import { verifyCsp } from "./lib/csp";
import { crossSiteResponse, isCrossSiteRequest } from "./lib/csrf";
import { pageView } from "./lib/page";
import { handleVerify } from "./lib/sign";
import VerifyDocument from "./VerifyDocument.astro";

export const prerender = false;

// A cross-site post would spend the visitor's per-IP verify allowance (CSRF, T034).
if (isCrossSiteRequest(Astro.request, Astro.url)) return crossSiteResponse();

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");
// The site's page sheet, allowed by its hash (T169).
const look = pageView(page, Astro.url);
Astro.response.headers.set(
	"Content-Security-Policy",
	await verifyCsp({ styles: [look.css], stylesheet: look.stylesheet }),
);

const form = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => new FormData()) : null;
const locale = pickLocale(Astro.currentLocale);
const { t, lang, dir } = translator(locale);
const view = await handleVerify({ locals: Astro.locals, url: Astro.url, request: Astro.request, pluginId }, form);
---
<EsignPage title={t("verify.title")} lang={lang} dir={dir} css={look.css} stylesheet={look.stylesheet} brand={look.brand}>
	<main class="semics-page-main" data-testid="verify-page">
		<h1>{t("verify.title")}</h1>
		<VerifyDocument view={view} locale={locale} />
	</main>
</EsignPage>
