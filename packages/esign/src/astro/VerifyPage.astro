---
// Injected at `/verify` by the integration (SU-FR-02, ES-US-6). Works without JavaScript: the visitor
// pastes the signed PDF's SHA-256; with scripts, they choose or drop the PDF and it is fingerprinted
// in the browser (never uploaded). Its CSP allows only the page's own hashed script and style.
import { pluginId } from "virtual:semics-esign/config";
import { verifyCsp } from "./lib/csp";
import { handleVerify } from "./lib/sign";
import VerifyDocument from "./VerifyDocument.astro";

export const prerender = false;

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Content-Security-Policy", await verifyCsp());

const form = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => new FormData()) : null;
const view = await handleVerify({ locals: Astro.locals, url: Astro.url, pluginId }, form);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="referrer" content="no-referrer" />
		<title>Verify a signed document</title>
	</head>
	<body>
		<main data-testid="verify-page">
			<h1>Verify a signed document</h1>
			<VerifyDocument view={view} />
		</main>
	</body>
</html>
