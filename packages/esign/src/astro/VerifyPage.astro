---
// Injected at `/verify` by the integration (SU-FR-02). Works without JavaScript: the visitor pastes
// the signed PDF's SHA-256 (or, with scripts, chooses the file to hash in the browser).
import { handleVerify } from "./lib/sign";

export const prerender = false;

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");

const form = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => new FormData()) : null;
const view = await handleVerify({ locals: Astro.locals, url: Astro.url }, form);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="referrer" content="no-referrer" />
		<title>Verify a signed document</title>
	</head>
	<body>
		<main class="semics-esign semics-verify" data-testid="verify-page">
			<h1>Verify a signed document</h1>
			<p>
				Check that a signed PDF is the one we issued and that its audit trail is intact. Enter its SHA-256
				fingerprint, shown on the certificate page. This confirms the record only; it does not identify anyone.
			</p>
			<form method="post" action="/verify">
				<p>
					<label for="esign-sha256">Document SHA-256</label><br />
					<input id="esign-sha256" name="sha256" type="text" inputmode="text" autocomplete="off" spellcheck="false" required pattern="[0-9a-fA-F]{64}" size="70" value={view.kind === "result" ? view.sha256 : ""} />
				</p>
				<p>
					<label for="esign-file">Or choose the PDF to fingerprint it here (it is not uploaded)</label><br />
					<input id="esign-file" type="file" accept="application/pdf" data-esign-file data-target="esign-sha256" hidden />
				</p>
				<button type="submit">Verify</button>
			</form>
			{view.kind === "error" && <p role="alert" data-testid="verify-error">{view.message}</p>}
			{
				view.kind === "result" && (
					<section data-testid="verify-result" aria-live="polite">
						{view.data.matched ? (
							<>
								<p>
									A signed document with this fingerprint was issued here
									{view.data.completedAt ? <> and completed on <time datetime={view.data.completedAt}>{view.data.completedAt}</time></> : null}.
								</p>
								<p data-testid="verify-chain">
									{view.data.chainVerified === true
										? "Its audit trail is intact."
										: view.data.chainVerified === false
											? "Warning: its audit trail does not verify."
											: "Its audit trail is too long to check online."}
								</p>
							</>
						) : (
							<p>No signed document with that fingerprint was found.</p>
						)}
					</section>
				)
			}
		</main>
		<script>
			import "../client/index.ts";
		</script>
	</body>
</html>
