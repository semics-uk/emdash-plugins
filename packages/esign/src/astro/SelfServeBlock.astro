---
// The `esign-request` Portable Text block (BUILD-PLAN 3.4): a form for a self-serve template (E-sign Pro).
// The visitor gives a name, an email address and any template fields and passes the security check; the
// signing link is then emailed to that address and is never shown here. A site on Free, or a template
// that is not offered, renders a short unavailable note instead of a form.
import { pickLocale, translator } from "../i18n/index.ts";
import { START_PATH, anchorOf, loadSelfServe, readStartState, startMessage } from "./lib/self-serve.ts";

interface Props {
	node?: { template?: string; heading?: string };
	template?: string;
	heading?: string;
	/** The page's language (T102); else `Astro.currentLocale` (a Portable Text block), else British English. */
	locale?: string;
}

const props = Astro.props as Props;
const templateId = (props.node?.template ?? props.template ?? "").trim();
const locale = pickLocale(props.locale, Astro.currentLocale);
const { t, lang, dir } = translator(locale);
const heading = props.node?.heading ?? props.heading ?? t("selfServe.heading");
const view = templateId ? await loadSelfServe(Astro, { templateId }) : ({ state: "unavailable" } as const);
const notice = readStartState(Astro.url, templateId);
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const id = anchorOf(templateId || "none");
---
{
	templateId && (
		<section id={id} class="semics-esign semics-esign-request" lang={lang} dir={dir} aria-labelledby={`${id}-title`} data-testid="esign-request">
			<h2 id={`${id}-title`}>{heading}</h2>
			{
				view.state === "unavailable" ? (
					<p data-testid="esign-request-unavailable">{t("selfServe.unavailable")}</p>
				) : notice.sent ? (
					<p role="status" data-testid="esign-request-sent">{t("selfServe.sent")}</p>
				) : (
					<form method="post" action={START_PATH} data-testid="esign-request-form">
						{notice.code && (
							<p role="alert" data-testid="esign-request-error">
								{startMessage(notice.code, locale)}
							</p>
						)}
						{view.template.description && <p>{view.template.description}</p>}
						<input type="hidden" name="templateId" value={templateId} />
						<input type="hidden" name="returnTo" value={returnTo} />
						<p>
							<label for={`${id}-name`}>{t("selfServe.name")}</label>
							<input id={`${id}-name`} name="name" autocomplete="name" required maxlength="200" />
						</p>
						<p>
							<label for={`${id}-email`}>{t("selfServe.email")}</label>
							<input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="254" />
						</p>
						{view.template.fields.map((key) => (
							<p>
								<label for={`${id}-f-${key}`}>{key.replaceAll("_", " ")}</label>
								<input id={`${id}-f-${key}`} name={`field:${key}`} required maxlength="500" />
							</p>
						))}
						<p style="position:absolute;inset-inline-start:-10000px;inline-size:1px;block-size:1px;overflow:hidden" aria-hidden="true">
							<label>
								{t("selfServe.honeypot")}
								<input name="website" tabindex="-1" autocomplete="off" />
							</label>
						</p>
						{view.turnstileSiteKey && (
							<>
								<div class="cf-turnstile" data-sitekey={view.turnstileSiteKey} data-theme="light"></div>
								{/* Turnstile is 300 px wide: compact when the form has less room, so a 320 px screen never scrolls sideways (WCAG 1.4.10). The form is measured, not the empty box; a form not laid out yet (0 px) falls back to the screen less 48 px. The same script as the booking widgets (T158, T159). Light, like the form. */}
								<script is:inline>(function (s) { var t = s && s.previousElementSibling, f = t && t.closest("form"), w = f ? f.clientWidth : 0; if (!w) w = document.documentElement.clientWidth - 48; if (t && w < 300) t.setAttribute("data-size", "compact"); })(document.currentScript);</script>
								<noscript>
									<p>{t("selfServe.needsJs")}</p>
								</noscript>
								<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
							</>
						)}
						<p>{t("selfServe.note")}</p>
						<button type="submit">{t("selfServe.button")}</button>
					</form>
				)
			}
		</section>
	)
}
