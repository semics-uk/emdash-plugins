{
	"name": "@semics-tech/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"description": "Pure helpers shared by the semics EmDash plugins. Source-only: the plugin bundler inlines it.",
	"license": "MIT",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./testing/budget.ts",
		"./testing/bundle-size": "./testing/bundle-size.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage --reporter=dot",
		"test:verify": "vitest run --reporter=dot ${CI:+--coverage}",
		"verify": "pnpm run typecheck && pnpm run test:verify"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.2.0",
		"@emdash-cms/plugin-cli": "0.13.3",
		"@emdash-cms/plugin-test": "0.2.8",
		"@vitest/coverage-v8": "4.1.12",
		"emdash": "1.2.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.12"
	}
}
