{
	"name": "@semics-tech/emdash-events",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./ui": {
			"import": "./dist/ts/ui/index.js",
			"types": "./dist/ts/ui/index.d.ts"
		},
		"./integration": {
			"import": "./dist/ts/integration/index.js",
			"types": "./dist/ts/integration/index.d.ts"
		},
		"./astro": "./src/astro/index.js",
		"./astro/checkout-endpoint": "./src/astro/checkout-endpoint.ts",
		"./astro/lib/*": "./src/astro/lib/*.ts",
		"./astro/BookingPage.astro": "./src/astro/BookingPage.astro",
		"./astro/DoorSignPage.astro": "./src/astro/DoorSignPage.astro",
		"./astro/BookingWidget.astro": "./src/astro/BookingWidget.astro",
		"./astro/BookingBlock.astro": "./src/astro/BookingBlock.astro",
		"./astro/EventList.astro": "./src/astro/EventList.astro",
		"./astro/EventCard.astro": "./src/astro/EventCard.astro",
		"./astro/BookingStatus.astro": "./src/astro/BookingStatus.astro",
		"./astro/TicketPass.astro": "./src/astro/TicketPass.astro",
		"./astro/AddToCalendar.astro": "./src/astro/AddToCalendar.astro"
	},
	"files": [
		"dist",
		"src/astro",
		"src/client",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build && tsc -p tsconfig.ui.json",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test:coverage": "vitest run --coverage --reporter=dot",
		"test:verify": "vitest run --reporter=dot ${CI:+--coverage}",
		"verify": "pnpm run validate && pnpm run typecheck && pnpm run test:verify && pnpm run build",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.2.0 <2"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.3",
		"@emdash-cms/plugin-test": "0.2.8",
		"@semics-tech/shared": "workspace:*",
		"@vitest/coverage-v8": "4.1.11",
		"emdash": "1.2.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0",
		"zod": "4.6.5"
	},
	"description": "Events bookings and ticketing for EmDash",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/semics-uk/emdash-plugins",
		"directory": "packages/events"
	}
}
