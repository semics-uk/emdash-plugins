---
// <BookingStatus>: a booking's state, order and cancel button (EU-FR-06). Rendered by the
// `/booking` page from the `public/booking` answer; the cancel form is a plain POST back to it.
import { type BookingView, formatMoney, statusLabel } from "./lib/widget";

interface Props {
	booking: BookingView;
	/** Shown as cancelled (the page just cancelled it). */
	cancelled?: boolean;
	/** Where the cancel form posts. */
	cancelAction?: string;
	/** Ticket type names by id, when the page knows them. */
	ticketNames?: Record<string, string>;
	locale?: string;
}

const { booking, cancelled = false, cancelAction, ticketNames = {}, locale = "en-GB" } = Astro.props;
const status = cancelled ? "cancelled" : booking.status;
const at = (iso: string) => {
	try {
		return new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(
			new Date(iso),
		);
	} catch {
		return iso;
	}
};
---
<section class="semics-events semics-booking-status" data-testid="booking-details" data-status={status} aria-labelledby="semics-booking-status-title">
	<h2 id="semics-booking-status-title" class="semics-visually-hidden">Booking status</h2>
	<p>
		Reference <strong data-testid="booking-ref">{booking.bookingRef}</strong>
	</p>
	<p class="semics-status" data-testid="booking-status" data-status={status}>
		<span class="semics-status-badge">{statusLabel(status)}</span>
	</p>
	{
		!cancelled && booking.holdExpiresAt && (
			<p data-testid="booking-hold">
				Your tickets are held until <time datetime={booking.holdExpiresAt}>{at(booking.holdExpiresAt)} UTC</time>.
			</p>
		)
	}
	<ul class="semics-lines">
		{
			booking.lines.map((line) => (
				<li>
					{line.qty} × {ticketNames[line.ticketTypeId] ?? line.ticketTypeId}
				</li>
			))
		}
	</ul>
	<p>Total <strong>{formatMoney(booking.totals.totalMinor, booking.totals.currency, locale)}</strong></p>
	{
		booking.canCancel && !cancelled && cancelAction && (
			<form method="post" action={cancelAction}>
				<input type="hidden" name="intent" value="cancel" />
				{booking.cancelBy && (
					<p>
						You can cancel until <time datetime={booking.cancelBy}>{at(booking.cancelBy)} UTC</time>.
					</p>
				)}
				<button type="submit">Cancel booking</button>
			</form>
		)
	}
</section>

<style>
	.semics-booking-status {
		box-sizing: border-box;
		max-inline-size: 36rem;
		color: var(--events-fg, #1a1a1a);
		overflow-wrap: anywhere;
	}
	.semics-status-badge {
		display: inline-block;
		padding: 0.125rem 0.5rem;
		border: 1px solid currentColor;
		border-radius: var(--events-radius, 6px);
		font-weight: 600;
	}
	.semics-booking-status[data-status="confirmed"] .semics-status-badge {
		color: var(--events-success, #146c2e);
	}
	.semics-booking-status button {
		font: inherit;
		min-block-size: 2.75rem;
		padding: 0.5rem 1rem;
	}
	.semics-visually-hidden {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
