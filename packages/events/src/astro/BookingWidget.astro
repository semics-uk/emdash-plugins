---
// <BookingWidget event={entryId} />: a plain form that posts to `/_events/checkout` (works with no
// JavaScript), enhanced by `src/client/booking.ts`. Loads the event's ticket types from
// `public/event` unless the page passes them as `data`. All text is rendered as text (Astro escapes
// every expression; nothing here injects raw HTML).
import { pluginId } from "virtual:semics-events/config";

import { pickLocale, translator } from "../i18n/index";
import { callPublicRoute } from "./lib/call";
import { CHECKOUT_PATH, QTY_PREFIX } from "./lib/checkout-form";
import { PROMO_PATH, type PromoView, promoCookieName, promoView } from "./lib/promo";
import { QUESTIONS_MARKER, questionControls } from "./lib/questions";
import { readWaitlistState, WAITLIST_PATH, waitlistMessage } from "./lib/waitlist";
import {
	anchorId,
	errorMessage,
	fieldMessage,
	formatMoney,
	newIdempotencyKey,
	type PublicEvent,
	readWidgetState,
	safeReturnTo,
	type WidgetField,
} from "./lib/widget";

interface Props {
	/** The event's content entry id. */
	event: string;
	/** The `public/event` answer, when the page already has it. */
	data?: PublicEvent;
	heading?: string;
	/** Overrides the site key from `public/event`. */
	turnstileSiteKey?: string;
	locale?: string;
	/** The applied promo code's view, when the page already has it (`null`: none). */
	promo?: PromoView | null;
}

const { event: eventId } = Astro.props;
// The language: the `locale` prop, else the page's (Astro i18n), else British English (T102).
const locale = pickLocale(Astro.props.locale, Astro.currentLocale);
const { t, lang, dir } = translator(locale);
const heading = Astro.props.heading ?? t("widget.heading");
const fieldText = (field: Parameters<typeof fieldMessage>[0]) => fieldMessage(field, locale);
let data = Astro.props.data;
if (!data) {
	const result = await callPublicRoute<PublicEvent>(Astro, {
		path: "public/event",
		pluginId,
		body: { eventId },
	});
	if (result.ok) data = result.data;
}

const id = anchorId(eventId);
// Promo codes are Events Pro's (T078): the field shows only when the core says it takes them. An
// applied code lives in an HttpOnly cookie (`/_events/promo`), never the URL, and is checked again here.
const takesCodes = data?.promoCodes === true;
let promo: PromoView | null = Astro.props.promo ?? null;
if (takesCodes && Astro.props.promo === undefined) {
	let code = "";
	try {
		code = Astro.cookies.get(promoCookieName(eventId))?.value ?? "";
	} catch {
		// A prerendered page has no cookies.
	}
	if (code) promo = await promoView(Astro, { eventId, code, currency: data?.currency, locale }, { pluginId });
}
const promoForm = `${id}-promo-form`;
const siteKey = Astro.props.turnstileSiteKey ?? data?.turnstileSiteKey ?? "";
const state = readWidgetState(Astro.url, eventId);
const returnTo = safeReturnTo(`${Astro.url.pathname}${Astro.url.search}`, Astro.url.origin) ?? "";
const occurrences = data?.occurrences ?? [];
const listed = new Set((data?.ticketTypes ?? []).map((t) => t.id));
// An unlock code's hidden types join the list (reserve checks the code again before it sells them).
const ticketTypes = [
	...(data?.ticketTypes ?? []),
	...(takesCodes ? (promo?.hiddenTypes ?? []) : []).filter((t) => !listed.has(t.id)),
] as PublicEvent["ticketTypes"];
const onSale = data?.status === "on_sale" && ticketTypes.length > 0;
// The waitlist (T081): offered when the core takes one and the tickets, or some dates, are sold out.
const fullDates = occurrences.filter((o) => o.available === 0);
const waitlist =
	onSale &&
	data?.waitlist === true &&
	(ticketTypes.every((t) => t.available === 0) || fullDates.length > 0);
const waitlistDates = ticketTypes.every((t) => t.available === 0) ? occurrences : fullDates;
const waitlistOutcome = readWaitlistState(Astro.url, eventId);
// Custom attendee questions are Events Pro's (T080): `public/event` lists them only on a Pro core.
const questions = questionControls(data?.questions, id, state.fields, locale);
const bad = (field: WidgetField) => state.fields.includes(field);
const errId = (field: WidgetField) => `${id}-${field}-error`;
const invalid = (field: WidgetField) => (bad(field) ? "true" : undefined);
const formAlert = state.code ? errorMessage(state.code, locale) : "";
const when = (iso: string) => {
	const options = { dateStyle: "full", timeStyle: "short" } as const;
	try {
		return new Intl.DateTimeFormat(locale, { ...options, timeZone: data?.timezone ?? "UTC" }).format(new Date(iso));
	} catch {
		return new Intl.DateTimeFormat(locale, { ...options, timeZone: "UTC" }).format(new Date(iso));
	}
};
---
<section id={id} class="semics-events semics-booking-widget" lang={lang} dir={dir} aria-labelledby={`${id}-title`} data-testid="booking-widget">
	<h2 id={`${id}-title`}>{heading}</h2>
	{
		!onSale ? (
			<p data-testid="booking-unavailable">{t("widget.unavailable")}</p>
		) : (
			<>
			{takesCodes && (
				<form id={promoForm} method="post" action={PROMO_PATH} hidden>
					<input type="hidden" name="eventId" value={eventId} />
					<input type="hidden" name="returnTo" value={returnTo} />
				</form>
			)}
			<form
				method="post"
				action={CHECKOUT_PATH}
				data-semics-booking
				data-currency={data?.currency}
				data-locale={locale}
				data-free={t("money.free")}
				data-turnstile={siteKey ? "on" : undefined}
				data-turnstile-message={siteKey ? t("widget.turnstile") : undefined}
			>
				<p class="semics-form-alert" role="alert" data-form-alert hidden={!formAlert}>{formAlert}</p>
				<input type="hidden" name="eventId" value={eventId} />
				<input type="hidden" name="returnTo" value={returnTo} />
				<input type="hidden" name="idempotencyKey" value={newIdempotencyKey()} />

				{occurrences.length > 0 && (
					<div class="semics-field">
						<input type="hidden" name="needsOccurrence" value="1" />
						<label for={`${id}-occurrence`}>{t("widget.date")}</label>
						<select
							id={`${id}-occurrence`}
							name="occurrenceId"
							required
							data-field="occurrence"
							aria-invalid={invalid("occurrence")}
							aria-describedby={errId("occurrence")}
						>
							<option value="">{t("widget.chooseDate")}</option>
							{occurrences.map((o) => (
								<option value={o.id} disabled={o.available === 0}>
									{o.available === 0 ? t("widget.dateSoldOut", { date: when(o.startsAt) }) : when(o.startsAt)}
								</option>
							))}
						</select>
						<p class="semics-field-error" id={errId("occurrence")} data-error-for="occurrence" data-message={fieldText("occurrence")}>
							{bad("occurrence") ? fieldText("occurrence") : ""}
						</p>
					</div>
				)}

				{takesCodes && (
					<div class="semics-field semics-promo">
						{promo && <input type="hidden" name="promoCode" value={promo.code} />}
						<label for={`${id}-promo`}>{t("widget.promo.label")}</label>
						<div class="semics-promo-row">
							<input
								id={`${id}-promo`}
								form={promoForm}
								name="promoCode"
								type="text"
								autocomplete="off"
								autocapitalize="characters"
								spellcheck="false"
								maxlength="60"
								value={promo?.code ?? ""}
								data-field="promo"
								aria-invalid={invalid("promo")}
								aria-describedby={`${errId("promo")}${promo ? ` ${id}-promo-note` : ""}`}
							/>
							<button type="submit" form={promoForm} class="semics-secondary" data-promo-apply>
								{promo ? t("widget.promo.update") : t("widget.promo.apply")}
							</button>
						</div>
						<p class="semics-field-error" id={errId("promo")} data-error-for="promo" data-message={fieldText("promo")}>
							{bad("promo") ? fieldText("promo") : ""}
						</p>
						{promo && (
							<p class="semics-promo-note" id={`${id}-promo-note`} data-testid="promo-note">
								{promo.note}
							</p>
						)}
					</div>
				)}

				<fieldset class="semics-tickets" data-field="tickets" aria-invalid={invalid("tickets")} aria-describedby={errId("tickets")}>
					<legend>{t("widget.tickets")}</legend>
					{ticketTypes.map((type) => {
						const soldOut = type.available === 0;
						const max = Math.min(type.maxPerOrder ?? 50, type.available ?? 50, 50);
						return (
							<div class="semics-ticket">
								<label for={`${id}-qty-${type.id}`}>
									<span class="semics-ticket-name">{type.name}</span>
									<span class="semics-ticket-price">{formatMoney(type.priceMinor, data?.currency ?? "GBP", locale)}</span>
									{soldOut && <span class="semics-ticket-soldout">{t("widget.soldOut")}</span>}
								</label>
								<input
									id={`${id}-qty-${type.id}`}
									type="number"
									inputmode="numeric"
									name={`${QTY_PREFIX}${type.id}`}
									value="0"
									min="0"
									max={String(max)}
									disabled={soldOut}
									data-price-minor={String(type.priceMinor)}
								/>
							</div>
						);
					})}
					<p class="semics-field-error" id={errId("tickets")} data-error-for="tickets" data-message={fieldText("tickets")}>
						{bad("tickets") ? fieldText("tickets") : ""}
					</p>
				</fieldset>

				<div class="semics-field">
					<label for={`${id}-name`}>{t("widget.name")}</label>
					<input
						id={`${id}-name`}
						name="name"
						type="text"
						autocomplete="name"
						required
						maxlength="200"
						data-field="name"
						aria-invalid={invalid("name")}
						aria-describedby={errId("name")}
					/>
					<p class="semics-field-error" id={errId("name")} data-error-for="name" data-message={fieldText("name")}>
						{bad("name") ? fieldText("name") : ""}
					</p>
				</div>

				<div class="semics-field">
					<label for={`${id}-email`}>{t("widget.email")}</label>
					<input
						id={`${id}-email`}
						name="email"
						type="email"
						autocomplete="email"
						required
						maxlength="254"
						data-field="email"
						aria-invalid={invalid("email")}
						aria-describedby={errId("email")}
					/>
					<p class="semics-field-error" id={errId("email")} data-error-for="email" data-message={fieldText("email")}>
						{bad("email") ? fieldText("email") : ""}
					</p>
				</div>

				{questions.length > 0 && (
					<fieldset class="semics-questions" data-testid="booking-questions">
						<legend>{t("widget.questions")}</legend>
						<input type="hidden" name={QUESTIONS_MARKER} value="1" />
						{questions.map((q) => (
							<div class={q.kind === "checkbox" ? "semics-field semics-check" : "semics-field"}>
								{q.kind === "checkbox" ? (
									<>
										<input
											id={q.id}
											type="checkbox"
											name={q.name}
											value="yes"
											required={q.required}
											data-question
											data-field={q.field}
											aria-invalid={q.invalid ? "true" : undefined}
											aria-describedby={q.errorId}
										/>
										<label for={q.id}>
											{q.label}
											{q.hint && <span class="semics-hint"> {q.hint}</span>}
										</label>
									</>
								) : (
									<>
										<label for={q.id}>
											{q.label}
											{q.hint && <span class="semics-hint"> {q.hint}</span>}
										</label>
										{q.kind === "select" ? (
											<select
												id={q.id}
												name={q.name}
												required={q.required}
												data-question
												data-field={q.field}
												aria-invalid={q.invalid ? "true" : undefined}
												aria-describedby={q.errorId}
											>
												{(q.options ?? []).map((o) => <option value={o.value}>{o.label}</option>)}
											</select>
										) : (
											<input
												id={q.id}
												type="text"
												name={q.name}
												maxlength={String(q.maxLength)}
												required={q.required}
												data-question
												data-field={q.field}
												aria-invalid={q.invalid ? "true" : undefined}
												aria-describedby={q.errorId}
											/>
										)}
									</>
								)}
								<p class="semics-field-error" id={q.errorId} data-error-for={q.field} data-message={q.message}>
									{q.invalid ? q.message : ""}
								</p>
							</div>
						))}
					</fieldset>
				)}

				<p class="semics-total" data-total data-testid="booking-total" hidden aria-live="polite">
					{t("widget.total")} <strong data-total-value></strong>
				</p>

				{siteKey && (
					<>
						<div class="cf-turnstile" data-sitekey={siteKey}></div>
						{/* Turnstile is 300 px wide; in a narrower widget use its compact size so a 320 px screen never scrolls sideways (WCAG 1.4.10). */}
						<script is:inline>(function (s) { var t = s && s.previousElementSibling; if (t && t.clientWidth < 300) t.setAttribute("data-size", "compact"); })(document.currentScript);</script>
						<noscript>
							<p class="semics-needs-js" data-testid="booking-needs-js">{t("widget.needsJs")}</p>
						</noscript>
						<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
					</>
				)}

				<button type="submit" disabled={siteKey ? true : undefined}>{t("widget.book")}</button>
			</form>
			{waitlist && (
				<form method="post" action={WAITLIST_PATH} class="semics-waitlist" data-testid="waitlist-form" aria-labelledby={`${id}-wl-title`}>
					<h3 id={`${id}-wl-title`}>{t("waitlist.heading")}</h3>
					<p>{t("waitlist.intro")}</p>
					{waitlistOutcome && (
						<p role={waitlistOutcome === "joined" ? "status" : "alert"} data-testid="waitlist-outcome" data-code={waitlistOutcome}>
							{waitlistMessage(waitlistOutcome, locale)}
						</p>
					)}
					<input type="hidden" name="eventId" value={eventId} />
					<input type="hidden" name="returnTo" value={returnTo} />
					{waitlistDates.length > 0 && (
						<div class="semics-field">
							<label for={`${id}-wl-date`}>{t("widget.date")}</label>
							<select id={`${id}-wl-date`} name="occurrenceId" required>
								{waitlistDates.map((o) => <option value={o.id}>{when(o.startsAt)}</option>)}
							</select>
						</div>
					)}
					{ticketTypes.length > 1 && (
						<div class="semics-field">
							<label for={`${id}-wl-type`}>{t("waitlist.ticket")}</label>
							<select id={`${id}-wl-type`} name="ticketTypeId">
								<option value="">{t("waitlist.anyTicket")}</option>
								{ticketTypes.map((type) => <option value={type.id}>{type.name}</option>)}
							</select>
						</div>
					)}
					<div class="semics-field">
						<label for={`${id}-wl-qty`}>{t("widget.tickets")}</label>
						<input id={`${id}-wl-qty`} name="qty" type="number" inputmode="numeric" min="1" max="10" value="1" required />
					</div>
					<div class="semics-field">
						<label for={`${id}-wl-name`}>{t("widget.name")}</label>
						<input id={`${id}-wl-name`} name="name" type="text" autocomplete="name" required maxlength="200" />
					</div>
					<div class="semics-field">
						<label for={`${id}-wl-email`}>{t("widget.email")}</label>
						<input id={`${id}-wl-email`} name="email" type="email" autocomplete="email" required maxlength="254" />
					</div>
					{siteKey && (
						<>
							<div class="cf-turnstile" data-sitekey={siteKey}></div>
							<script is:inline>(function (s) { var t = s && s.previousElementSibling; if (t && t.clientWidth < 300) t.setAttribute("data-size", "compact"); })(document.currentScript);</script>
						</>
					)}
					<button type="submit" class="semics-secondary">{t("waitlist.button")}</button>
				</form>
			)}
			</>
		)
	}
</section>

<script>
	import "../client/booking.ts";
</script>

<style>
	.semics-booking-widget {
		--_fg: var(--events-fg, #1a1a1a);
		--_muted: var(--events-muted, #4a4a4a);
		--_bg: var(--events-bg, #ffffff);
		--_border: var(--events-border, #6b6b6b);
		--_accent: var(--events-accent, #0b57d0);
		--_accent-fg: var(--events-accent-fg, #ffffff);
		--_error: var(--events-error, #b3261e);
		--_radius: var(--events-radius, 6px);
		box-sizing: border-box;
		max-inline-size: 36rem;
		padding: 1rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		background: var(--_bg);
		color: var(--_fg);
		overflow-wrap: anywhere;
	}
	.semics-booking-widget *,
	.semics-booking-widget *::before,
	.semics-booking-widget *::after {
		box-sizing: border-box;
	}
	.semics-booking-widget h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}
	.semics-booking-widget form {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
	}
	.semics-booking-widget .semics-waitlist {
		margin-block-start: 1.25rem;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--_border);
	}
	.semics-waitlist h3,
	.semics-waitlist p {
		margin: 0;
	}
	.semics-tickets {
		margin: 0;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		min-inline-size: 0;
	}
	.semics-questions {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0.5rem 0.75rem 0.75rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		min-inline-size: 0;
	}
	.semics-check {
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		column-gap: 0.5rem;
	}
	.semics-check .semics-field-error {
		grid-column: 1 / -1;
	}
	.semics-booking-widget .semics-check input {
		min-block-size: 1.25rem;
		inline-size: 1.25rem;
		margin: 0;
	}
	.semics-hint {
		color: var(--_muted);
	}
	.semics-ticket {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-block: 0.25rem;
	}
	.semics-ticket label {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.5rem;
		flex: 1 1 10rem;
		min-inline-size: 0;
	}
	.semics-ticket-price,
	.semics-ticket-soldout {
		color: var(--_muted);
	}
	.semics-ticket input {
		inline-size: 5rem;
	}
	.semics-field {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.25rem;
	}
	.semics-field select {
		inline-size: 100%;
	}
	.semics-booking-widget input,
	.semics-booking-widget select,
	.semics-booking-widget button {
		font: inherit;
		min-block-size: 2.75rem;
		max-inline-size: 100%;
	}
	.semics-booking-widget input,
	.semics-booking-widget select {
		padding: 0.375rem 0.5rem;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		background: var(--_bg);
		color: var(--_fg);
	}
	.semics-booking-widget [aria-invalid="true"] {
		border-color: var(--_error);
		outline: 1px solid var(--_error);
	}
	.semics-field-error,
	.semics-form-alert {
		margin: 0;
		color: var(--_error);
	}
	.semics-field-error:empty {
		display: none;
	}
	.semics-form-alert {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--_error);
		border-radius: var(--_radius);
	}
	.semics-needs-js {
		margin: 0;
		font-weight: 600;
	}
	.semics-total {
		margin: 0;
	}
	.semics-booking-widget button {
		justify-self: start;
		padding: 0.5rem 1.5rem;
		border: 0;
		border-radius: var(--_radius);
		background: var(--_accent);
		color: var(--_accent-fg);
		cursor: pointer;
	}
	.semics-promo-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.semics-promo-row input {
		flex: 1 1 10rem;
		min-inline-size: 0;
	}
	.semics-booking-widget button.semics-secondary {
		padding-inline: 1rem;
		border: 1px solid var(--_accent);
		background: var(--_bg);
		color: var(--_accent);
	}
	.semics-promo-note {
		margin: 0;
		color: var(--_muted);
	}
	.semics-booking-widget button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
	.semics-booking-widget :focus-visible {
		outline: 3px solid var(--_accent);
		outline-offset: 2px;
	}
	[hidden] {
		display: none !important;
	}
</style>
