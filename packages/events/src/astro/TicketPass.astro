---
// <TicketPass>: one attendee's ticket with the check-in code (EU-FR-07). With Events Pro the core also sends the
// code's QR matrix (`qr`, T082), drawn here as an SVG for the door's camera. The code is the core's 43-character
// value, which door check-in matches exactly, so it is never shortened, only shown smaller (T158): with a QR the face
// of the pass shows none (the QR carries it) and "Show the code to type in" reveals it on screen, and a printed pass
// carries it on one small line under the QR; without a QR (Free) it is the way in and shows in full. The code is
// grouped in fours by spacing (the text stays the exact value); screen readers get it character by character.
import { pickLocale, translator } from "../i18n/index";
import { codeGroups, qrPath } from "./lib/pass";

interface Props {
	name: string;
	code: string;
	ticket?: string;
	event?: string;
	status?: string;
	/** `{ size, bits }` from Events Pro's `public/booking`; anything else draws no QR. */
	qr?: unknown;
	locale?: string;
}

const { name, code, ticket, event, status, qr } = Astro.props;
const { t, lang, dir } = translator(pickLocale(Astro.props.locale, Astro.currentLocale));
const statusText =
	status === "pending" ? t("pass.status.pending") : status === "cancelled" ? t("pass.status.cancelled") : status;
const spoken = code.replace(/[^A-Za-z0-9]/g, "").split("").join(" ");
const groups = codeGroups(code);
const matrix = qrPath(qr);
const box = matrix ? matrix.size + 8 : 0;
---
<article class="semics-events semics-ticket-pass" lang={lang} dir={dir} data-testid="ticket-pass" data-status={status} data-qr={matrix ? "" : undefined}>
	{matrix && (
		<div class="semics-pass-qr-box">
			<svg
				class="semics-pass-qr"
				data-testid="ticket-qr"
				role="img"
				aria-label={t("pass.qr")}
				viewBox={`-4 -4 ${box} ${box}`}
				shape-rendering="crispEdges"
			>
				<rect x="-4" y="-4" width={box} height={box} fill="#ffffff" />
				<path d={matrix.d} fill="#000000" />
			</svg>
			<p class="semics-pass-code-print" aria-hidden="true" data-testid="ticket-code-print">{groups.map((g) => <span>{g}</span>)}</p>
		</div>
	)}
	<div class="semics-pass-text">
		{event && <p class="semics-pass-event">{event}</p>}
		<h3 class="semics-pass-name">{name}</h3>
		{ticket && <p class="semics-pass-ticket">{ticket}</p>}
		{!matrix && (
			<>
				<p class="semics-pass-code-label">{t("pass.code")}</p>
				<p class="semics-pass-code">
					<span aria-hidden="true" data-testid="ticket-code">{groups.map((g) => <span>{g}</span>)}</span>
					<span class="semics-visually-hidden">{spoken}</span>
				</p>
			</>
		)}
		{status && status !== "valid" && <p class="semics-pass-status">{statusText}</p>}
	</div>
	{matrix && (
		<details class="semics-pass-more">
			<summary>{t("pass.codeShow")}</summary>
			<p class="semics-pass-code">
				<span aria-hidden="true" data-testid="ticket-code">{groups.map((g) => <span>{g}</span>)}</span>
				<span class="semics-visually-hidden">{spoken}</span>
			</p>
		</details>
	)}
</article>

<style>
	/* The QR beside the attendee and the code (T157); stacked on a narrow screen. */
	.semics-ticket-pass {
		box-sizing: border-box;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		max-inline-size: 32rem;
		margin-block: 0 0.75rem;
		padding: 1rem;
		border: 2px dashed var(--events-border, #6b6b6b);
		border-radius: var(--events-radius, 6px);
		background: var(--events-bg, #ffffff);
		color: var(--events-fg, #1a1a1a);
		overflow-wrap: anywhere;
	}
	.semics-pass-text {
		flex: 1 1 12rem;
		min-inline-size: 0;
	}
	.semics-ticket-pass p,
	.semics-ticket-pass h3 {
		margin: 0 0 0.25rem;
	}
	.semics-pass-event,
	.semics-pass-ticket,
	.semics-pass-code-label {
		color: var(--events-muted, #4a4a4a);
	}
	.semics-pass-code-label {
		font-size: 0.875rem;
	}
	.semics-pass-qr-box {
		flex: none;
		inline-size: min(100%, 10rem);
	}
	/* Black on white in every theme: phone cameras read dark modules on a light ground. */
	.semics-pass-qr {
		display: block;
		inline-size: 100%;
		block-size: auto;
		aspect-ratio: 1;
	}
	/* Groups of four, spaced rather than separated, so the text is the exact code; a line breaks only between groups. */
	.semics-pass-code,
	.semics-pass-code-print {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		overflow-wrap: normal;
	}
	.semics-pass-code {
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: 0.02em;
		font-weight: 600;
	}
	.semics-pass-code > [data-testid] {
		display: block;
	}
	.semics-pass-code > [data-testid] > span,
	.semics-pass-code-print > span {
		display: inline-block;
		margin-inline-end: 0.35em;
	}
	/* Without a QR the code is what the door types in: a little larger. */
	.semics-ticket-pass:not([data-qr]) .semics-pass-code {
		font-size: 0.9375rem;
	}
	/* The pass's full width, under the QR and the name, so the code fits one line on a desktop. */
	.semics-pass-more {
		flex: 1 1 100%;
	}
	.semics-pass-more summary {
		color: var(--events-accent, #0b57d0);
		font-size: 0.875rem;
		cursor: pointer;
	}
	.semics-pass-more .semics-pass-code {
		margin-block: 0.375rem 0;
	}
	.semics-pass-code-print {
		display: none;
	}
	.semics-visually-hidden {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	@media print {
		.semics-ticket-pass {
			break-inside: avoid;
			border-color: #000000;
			color: #000000;
		}
		.semics-pass-qr-box {
			inline-size: auto;
		}
		.semics-pass-qr {
			inline-size: 35mm;
		}
		/* The QR's fallback for the door: the full code, one small line under it. */
		.semics-pass-code-print {
			display: block;
			margin: 1.5mm 0 0;
			font-size: 6.5pt;
			line-height: 1.3;
			white-space: nowrap;
		}
		.semics-pass-code-print > span {
			margin-inline-end: 0.25em;
		}
		.semics-ticket-pass:not([data-qr]) .semics-pass-code {
			font-size: 9pt;
			white-space: nowrap;
		}
	}
</style>
