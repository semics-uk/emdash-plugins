---
// Injected at `/booking` by the integration. The booking ref is in the URL; the access token is
// only ever in the HttpOnly cookie the checkout endpoint set, and goes to the core in POST bodies.
// The emailed link (`?ref=&k=<one-time code>`, R34) renders an "Open my booking" button and
// redeems nothing: only its POST swaps the code for a token, sets the cookie and redirects to
// `?ref=` without `k`, so mail scanners that prefetch links cannot use the code up.
// It is also the waiver return page (EV-FR-12): e-sign sends the signer back to `?ref=#receipt=`;
// `src/client/receipt.ts` clears the fragment and posts the receipt here, which forwards it to the
// core's `signatures/receipt` (no access token needed: the receipt is HMAC-signed) and redirects to
// `?ref=&waiver=<outcome>`.
import { esignPluginId, pluginId, reconcile } from "virtual:semics-events/config";

import AddToCalendar from "./AddToCalendar.astro";
import BookingStatus from "./BookingStatus.astro";
import PaymentReturn from "./PaymentReturn.astro";
import { callPublicRoute } from "./lib/call";
import {
	bookingCookieName,
	bookingCookieOptions,
	crossSiteResponse,
	isCrossSiteRequest,
	LINK_INVALID,
	redeemBookingLink,
	resumePayment,
} from "./lib/checkout-form";
import { paymentView } from "./lib/payment";
import { forwardReceipt } from "./lib/receipt";
import type { BookingView } from "./lib/widget";
import TicketPass from "./TicketPass.astro";

export const prerender = false;

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");

const MESSAGES: Record<string, string> = {
	SOLD_OUT: "Sorry, those tickets are sold out.",
	SALES_CLOSED: "Ticket sales for this event are closed.",
	HOLD_EXPIRED: "Your hold on these tickets expired. Please start again.",
	PAYMENT_FAILED: "Payment could not be started. Your tickets are held for a short time.",
	CANCEL_NOT_ALLOWED: "This booking can no longer be cancelled online.",
	BAD_REQUEST: "Please choose at least one ticket and fill in your name and email.",
	[LINK_INVALID]: "This booking link has expired or was already used. Open your booking on the device you booked with.",
};
const WAIVER_MESSAGES: Record<string, string> = {
	signed: "Thank you: your waiver is signed.",
	declined: "The waiver was declined, so this ticket is not valid yet. You can sign it from the booking again.",
	voided: "This waiver was withdrawn. Please sign it again from the booking.",
	expired: "The signing link expired. Please sign the waiver again from the booking.",
	failed: "We could not record that signature. Please try again from the booking.",
};

const url = Astro.url;
const rawRef = url.searchParams.get("ref") ?? "";
const ref = /^[0-9A-HJKMNP-TV-Z]{10}$/.test(rawRef) ? rawRef : "";
const errorCode = url.searchParams.get("error") ?? "";
const waiverNotice = WAIVER_MESSAGES[url.searchParams.get("waiver") ?? ""] ?? "";
let notice = errorCode ? (MESSAGES[errorCode] ?? "Something went wrong. Please try again.") : waiverNotice;
const code = url.searchParams.get("k") ?? "";
const ctx = { locals: Astro.locals, url, request: Astro.request };
// The cancel and redeem forms post here: refuse another site's posts (CSRF) before reading them.
if (isCrossSiteRequest(Astro.request, url)) return crossSiteResponse();
const form = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => new FormData()) : undefined;

if (form?.get("intent") === "receipt") {
	const result = await forwardReceipt(ctx, { ref: rawRef, receipt: form.get("receipt") }, { pluginId, esignPluginId });
	return Astro.redirect(result.location, 303);
}
if (form?.get("intent") === "redeem") {
	const k = form.get("k");
	const result = await redeemBookingLink(ctx, { ref: rawRef, code: typeof k === "string" ? k : "" }, { pluginId });
	if (result.cookie) Astro.cookies.set(result.cookie.name, result.cookie.value, bookingCookieOptions(url));
	return Astro.redirect(result.location, 303);
}
if (form?.get("intent") === "resume") {
	// "Pay now": the token is the cookie's, never a field; nothing Stripe appends to the URL is read.
	const token = ref ? (Astro.cookies.get(bookingCookieName(ref))?.value ?? "") : "";
	const result = await resumePayment(ctx, { ref: rawRef, token }, { pluginId });
	return Astro.redirect(result.location, 303);
}
// An emailed link: show the button and touch nothing else (GET must not redeem).
const opening = Boolean(ref && code);
const token = ref && !opening ? (Astro.cookies.get(bookingCookieName(ref))?.value ?? "") : "";

let cancelled = false;
if (ref && token && form) {
	if (form.get("intent") === "cancel") {
		const result = await callPublicRoute(ctx, {
			method: "POST",
			path: "public/booking/cancel",
			pluginId,
			body: { bookingRef: ref, accessToken: token },
		});
		if (result.ok) cancelled = true;
		else notice = MESSAGES[result.error.code] ?? "We could not cancel this booking.";
	}
}

let booking: BookingView | undefined;
let missing = false;
if (ref && token) {
	const result = await callPublicRoute<BookingView>(ctx, {
		method: "POST",
		path: "public/booking",
		pluginId,
		body: { bookingRef: ref, accessToken: token },
	});
	if (result.ok) booking = result.data;
	else missing = true;
	// A booking waiting for signatures is reconciled with e-sign (the suite supplies `reconcile`): a signer who
	// closed the tab or signed by email has a receipt this page forwards, then it shows the booking afresh.
	if (booking?.waiver?.lookups && reconcile && esignPluginId) {
		const done = await reconcile(ctx, { booking, pluginId, esignPluginId });
		if (done.forwarded > 0) {
			const fresh = await callPublicRoute<BookingView>(ctx, {
				method: "POST",
				path: "public/booking",
				pluginId,
				body: { bookingRef: ref, accessToken: token },
			});
			if (fresh.ok) booking = fresh.data;
		}
	}
} else if (ref && !opening) {
	missing = true;
}
const payment = booking && !cancelled ? paymentView(booking) : null;
const passes = booking && !cancelled && booking.status === "confirmed" ? booking.attendees.filter((a) => a.code) : [];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="referrer" content="no-referrer" />
		<title>Your booking</title>
	</head>
	<body>
		<main class="semics-booking" data-testid="booking-page">
			<h1>Your booking</h1>
			<form method="post" action={ref ? `/booking?ref=${ref}` : "/booking"} data-semics-fragment="receipt" hidden>
				<input type="hidden" name="intent" value="receipt" />
				<input type="hidden" name="receipt" value="" />
			</form>
			{notice && <p role="alert" data-testid="booking-notice" data-code={errorCode}>{notice}</p>}
			{
				opening ? (
					<form method="post" action={`/booking?ref=${ref}`} class="semics-events semics-booking-open" data-testid="booking-open">
						<input type="hidden" name="intent" value="redeem" />
						<input type="hidden" name="k" value={code} />
						<p>Open your booking on this device. The link works once; after that this browser remembers it.</p>
						<button type="submit">Open my booking</button>
					</form>
				) : booking ? (
					<>
						<BookingStatus booking={booking} cancelled={cancelled} cancelAction={`/booking?ref=${ref}`} />
						{payment && <PaymentReturn view={payment} bookingRef={ref} action={`/booking?ref=${ref}`} />}
						{passes.length > 0 && (
							<section aria-labelledby="semics-passes-title">
								<h2 id="semics-passes-title">Tickets</h2>
								{passes.map((a) => (
									<TicketPass name={a.name} code={a.code ?? ""} status={a.status} />
								))}
							</section>
						)}
						{!cancelled && booking.status === "confirmed" && <AddToCalendar signedQuery={booking.calendar?.query} />}
					</>
				) : missing ? (
					<p data-testid="booking-missing">
						We could not find that booking in this browser. Open the link from the device you booked with.
					</p>
				) : !notice ? (
					<p data-testid="booking-empty">Add your booking reference to view it.</p>
				) : null
			}
		</main>
		<script>
			import "../client/receipt.ts";
			import "../client/payment.ts";
		</script>
	</body>
</html>
