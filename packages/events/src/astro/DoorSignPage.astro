---
// Injected at `/_events/sign` by the integration: the door signing page (EV-FR-12). Check-in refuses
// an attendee whose waiver is pending and shows staff a link `/_events/sign#intent=<token>` (minted
// by the Pro core for that attendee, signing for themselves). The intent stays in the fragment:
// `src/client/receipt.ts` clears it and posts it here; this page redeems it with e-sign in-process
// (`public/envelopes/from-intent`) and sends the browser to e-sign's signing page. Afterwards e-sign
// returns to `/booking?ref=…#receipt=…`, which records the receipt.
import { esignPluginId, pluginId } from "virtual:semics-events/config";

import { type MessageKey, pickLocale, translator } from "../i18n/index";
import { crossSiteResponse, isCrossSiteRequest } from "./lib/checkout-form";
import { startDoorSigning } from "./lib/receipt";

export const prerender = false;

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "private, no-store");

const { t, lang, dir } = translator(pickLocale(Astro.currentLocale));
const CODES = ["ESIGN_NOT_CONFIGURED", "INTENT_INVALID", "TOKEN_EXPIRED", "TOKEN_REPLAYED", "SIGNING_UNAVAILABLE"];

const ctx = { locals: Astro.locals, url: Astro.url, request: Astro.request };
if (isCrossSiteRequest(Astro.request, Astro.url)) return crossSiteResponse();
let error = "";
let signed = false;
if (Astro.request.method === "POST") {
	const form = await Astro.request.formData().catch(() => new FormData());
	const result = await startDoorSigning(ctx, form.get("intent"), { esignPluginId, pluginId }, form.get("lookup"));
	if ("location" in result) return Astro.redirect(result.location, 303);
	if ("signed" in result) signed = true;
	else error = t(`door.error.${CODES.includes(result.error) ? result.error : "INTERNAL"}` as MessageKey);
}
---
<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="referrer" content="no-referrer" />
		<title>{t("door.title")}</title>
	</head>
	<body>
		<main class="semics-booking" data-testid="door-sign-page">
			<h1>{t("door.title")}</h1>
			{signed ? (
				<p role="status" data-testid="door-sign-signed">{t("door.signed")}</p>
			) : error ? (
				<p role="alert" data-testid="door-sign-error">{error}</p>
			) : (
				<p>{t("door.opening")}</p>
			)}
			<form method="post" action="/_events/sign" data-semics-fragment="intent" hidden>
				<input type="hidden" name="intent" value="" />
				<input type="hidden" name="lookup" value="" />
			</form>
		</main>
		<script>
			import "../client/receipt.ts";
		</script>
	</body>
</html>
