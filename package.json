{
  "name": "emdash-plugins",
  "private": true,
  "description": "semics Events bookings and E-sign plugins for EmDash",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test": "pnpm -r --filter ./packages/** test",
    "validate": "pnpm -r --filter ./packages/** validate",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter playground dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
