---
// Spike S2 probe page (repointed by T054): server-renders the sandboxed core's real `public/events`
// route through `callPublicRoute`. `?plugin=` targets another plugin ID so the not-enabled error
// state can be exercised.
import { callPublicRoute } from "@semics-tech/emdash-events/astro";
import { pluginId as configuredId } from "virtual:semics-events/config";

export const prerender = false;

const pluginId = Astro.url.searchParams.get("plugin") ?? configuredId;
const result = await callPublicRoute<{ events: Array<{ title: string }> }>(Astro, {
	path: "public/events",
	pluginId,
});
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Spike S2 probe</title>
	</head>
	<body>
		<main data-testid="s2-result" data-state={result.ok ? "ok" : "error"} data-via={result.via}>
			{
				result.ok ? (
					<dl>
						<dt>Plugin</dt>
						<dd data-testid="s2-plugin-id">{pluginId}</dd>
						<dt>Method</dt>
						<dd data-testid="s2-method">GET</dd>
						<dt>Events</dt>
						<dd data-testid="s2-echo">{result.data.events.map((e) => e.title).join(",")}</dd>
					</dl>
				) : (
					<p role="alert">
						Events are unavailable right now (<code data-testid="s2-error-code">{result.error.code}</code>).
					</p>
				)
			}
		</main>
	</body>
</html>
