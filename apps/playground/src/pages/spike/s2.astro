---
// Spike S2 (T004) probe page: server-renders the sandboxed core's public/probe route.
// `?plugin=` targets another plugin ID so the not-enabled error state can be exercised.
import { callPublicRoute, EVENTS_PLUGIN_ID } from "@semics-tech/emdash-events/astro";

export const prerender = false;

const pluginId = Astro.url.searchParams.get("plugin") ?? EVENTS_PLUGIN_ID;
const result = await callPublicRoute<{ pluginId: string; method: string; echo: unknown }>(Astro, {
	method: "POST",
	path: "public/probe",
	body: { ping: "s2" },
	pluginId,
});
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Spike S2 probe</title>
	</head>
	<body>
		<main data-testid="s2-result" data-state={result.ok ? "ok" : "error"} data-via={result.via}>
			{
				result.ok ? (
					<dl>
						<dt>Plugin</dt>
						<dd data-testid="s2-plugin-id">{result.data.pluginId}</dd>
						<dt>Method</dt>
						<dd data-testid="s2-method">{result.data.method}</dd>
						<dt>Echo</dt>
						<dd data-testid="s2-echo">{JSON.stringify(result.data.echo)}</dd>
					</dl>
				) : (
					<p role="alert">
						Events are unavailable right now (<code data-testid="s2-error-code">{result.error.code}</code>).
					</p>
				)
			}
		</main>
	</body>
</html>
