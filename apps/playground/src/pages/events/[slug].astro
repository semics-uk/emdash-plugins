---
import { decodeSlug, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import BookingWidget from "@semics-tech/emdash-events/astro/BookingWidget.astro";
import Base from "../../layouts/Base.astro";
import { bookingFixture } from "../../utils/booking-fixture";

const slug = decodeSlug(Astro.params.slug);
const { entry: event, cacheHint } = slug
	? await getEmDashEntry("events", slug)
	: { entry: null, cacheHint: undefined };

if (!event) {
	return new Response(null, { status: 404 });
}
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

// biome-ignore lint/suspicious/noExplicitAny: the events collection is not in the generated types
const data = event.data as Record<string, any>;
const startsAt = new Date(data.starts_at);
const booking = bookingFixture(slug ?? "", data.id, data.timezone);
---

<Base
	title={data.title}
	description={data.summary}
	content={{ collection: "events", id: data.id, slug }}
>
	<article>
		<h1 {...event.edit.title}>{data.title}</h1>
		<p>
			<time data-testid="event-starts-at" datetime={startsAt.toISOString()}>
				{startsAt.toISOString()}
			</time>
			(<span data-testid="event-timezone">{data.timezone}</span>)
		</p>
		{data.venue && <p data-testid="event-venue">{data.venue}</p>}
		<PortableText value={data.body} />
		{booking && <BookingWidget event={data.id} data={booking} />}
	</article>
</Base>
